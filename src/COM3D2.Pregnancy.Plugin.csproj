<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>COM3D2.Pregnancy.Plugin</AssemblyName>
    <RootNamespace>COM3D2.Pregnancy.Plugin</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Build directly into BepInEx\plugins. -->
    <OutputPath>E:\com3d2\BepinEx\plugins\</OutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <!-- Keep referenced game DLLs out of the build output. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ================================================================
       Set the COM3D2 installation root that contains the BepInEx folder.
       ================================================================ -->
  <PropertyGroup>
    <GameDir>E:\com3d2</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude backup directories -->
    <Compile Remove="src_v0.2.0_morph_compat\**" />
    <Compile Remove="src_extracted\**" />
    <Compile Remove="backup\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx core -->
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\COM3D2x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Game assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\COM3D2x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
