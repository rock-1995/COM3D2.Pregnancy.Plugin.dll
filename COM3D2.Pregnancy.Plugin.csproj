<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AssemblyName>COM3D2.Pregnancy.Plugin</AssemblyName>
    <RootNamespace>COM3D2.Pregnancy.Plugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Default output goes directly to BepInEx/plugins; override OutputPath for staging. -->
    <OutputPath>$(GameDir)/BepInEx/plugins/</OutputPath>
    <!-- Do not copy referenced game assemblies to the output. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ================================================================
       Set this to the COM3D2 installation root containing BepInEx.
       ================================================================ -->
  <PropertyGroup>
    <GameDir>E:\com3d2</GameDir>
    <!-- Compile against the same legacy Mono profile used by this Unity player. -->
    <FrameworkPathOverride>$(GameDir)\COM3D2x64_Data\Managed</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Reference Include="System">
      <HintPath>$(FrameworkPathOverride)\System.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(FrameworkPathOverride)\System.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- BepInEx core -->
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\COM3D2x64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Game assemblies -->
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameDir)\COM3D2x64_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\COM3D2x64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
